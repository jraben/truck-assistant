// /etc/polkit-1/rules.d/50-slate-network.rules  (install.sh puts it there)
// Lets the brain's service user (slate) manage NetworkManager connections:
// scan, add/modify/delete its own slate-net-* profiles, and bring them up.
// The brain only ever names slate-net-* profiles and the client radio; the
// slate-ap access point profile on wlan0 is left alone (see src/network.ts).
polkit.addRule(function (action, subject) {
  if (subject.user !== "slate") return polkit.Result.NOT_HANDLED;
  if (action.id === "org.freedesktop.NetworkManager.network-control" ||
      action.id === "org.freedesktop.NetworkManager.settings.modify.system" ||
      action.id === "org.freedesktop.NetworkManager.wifi.scan" ||
      action.id === "org.freedesktop.NetworkManager.enable-disable-wifi") {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
